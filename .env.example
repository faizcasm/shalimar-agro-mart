# ============================================================
# Shalimar Agro Mart — environment variables
# Copy to .env.local (dev) / set in Vercel project settings (prod).
# Everything is optional: without these, forms fall back to
# opening WhatsApp / email deep-links automatically.
# ============================================================

# --- MongoDB (required for storing submissions) ---
# MongoDB Atlas free cluster: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# Optional (defaults to shalimar_agro)
MONGODB_DB=shalimar_agro

# --- WhatsApp Business Cloud API (Meta) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api
# Phone Number ID + permanent token from your Meta app.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: approved template name for business-initiated messages.
# Without it, a plain text message is attempted (works when the
# recipient is your own business number).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Optional: override recipient (defaults to 919070999299)
WHATSAPP_TO=

# --- Email (SMTP) — sends to shalimaragromart@gmail.com ---
# Gmail: enable 2FA, then create an App Password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shalimaragromart@gmail.com
SMTP_PASS=
# Optional: "Name <address>" sender (defaults to SMTP_USER)
SMTP_FROM=
